# =====================================================
# Vision AI - Environment Variables (TEMPLATE)
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file.
# =====================================================

# ---------- Node.js backend ----------
NODE_ENV=development
PORT=3000

# ---------- Python AI service ----------
# Node uses this URL to reach FastAPI.
# 127.0.0.1 = localhost only. Not reachable from the network.
PYTHON_AI_URL=http://127.0.0.1:8000
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000

# ---------- Database ----------
DB_PATH=./data/vision_ai.db

# ---------- Vision LLM (needed in Phase 12, not before) ----------
# Vision models, tried in order. Must be DIFFERENT models: the free tier
# allows 15 requests per minute per model, so three give three times the
# room. Aliases like gemini-flash-lite-latest share their target's quota.
# If Google retires one (it answers 404), the next is used automatically.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
GEMINI_API_KEY=your_key_here

# ---------- Text-to-speech (only for Hindi/Marathi/Gujarati) ----------
# English uses the browser's own voice. Other languages use Edge neural
# voices (free, no quota); Gemini speech is only a last resort because the
# free tier allows just 10 requests per day per model.
TTS_MODEL=gemini-3.8-flash-lite-tts
TTS_FALLBACK_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Kore
TTS_CACHE_DIR=data/tts-cache
