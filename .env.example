# =====================================================
# Vision AI - Environment Variables (TEMPLATE)
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file.
# =====================================================

# ---------- Node.js backend ----------
NODE_ENV=development
PORT=3000

# ---------- Python AI service ----------
# Node uses this URL to reach FastAPI.
# 127.0.0.1 = localhost only. Not reachable from the network.
PYTHON_AI_URL=http://127.0.0.1:8000
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000

# ---------- Database ----------
DB_PATH=./data/vision_ai.db

# ---------- Vision LLM (needed in Phase 12, not before) ----------
# Model aliases (not pinned versions: pinned models get retired).
# "lite" models are 4-5x faster and accurate enough for image description.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_key_here

# ---------- Text-to-speech (only for Hindi/Marathi/Gujarati) ----------
# English uses the free offline browser voice and never calls the API.
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Kore
TTS_DAILY_LIMIT=200
