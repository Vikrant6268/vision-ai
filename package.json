{
  "name": "vision-ai",
  "version": "1.0.0",
  "description": "Vision AI - Smart Assistant for Visually Impaired People",
  "type": "module",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "node tests/test-policy.js && node tests/test-api.js",
    "test:policy": "node tests/test-policy.js"
  },
  "keywords": [
    "accessibility",
    "computer-vision",
    "assistive-technology"
  ],
  "author": "Vikrant",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.0",
    "node-edge-tts": "^1.2.10",
    "onnxruntime-web": "^1.30.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "nodemonConfig": {
    "watch": [
      "backend"
    ],
    "ext": "js,json"
  },
  "engines": {
    "node": "22.x"
  }
}
